
# ── ChessERP (API de solo lectura para traer los pedidos pendientes) ──
# Cargá los valores reales en backend/.env (nunca en el código ni en el chat).
# Requiere un usuario de tipo API PÚBLICA (alta nueva en el ERP, con costo) con permisos de Comprobantes y Listas de precios.
CHESS_BASE_URL=https://beertan.chesserp.com/AR485/web/api/chess/v1
CHESS_USER=
CHESS_PASSWORD=
# CHESS_LOGIN_PATH=auth/login
# CHESS_PEDIDOS_PATH=pedidos
# CHESS_SUCURSALES=1,2                    (opcional: solo estas sucursales, ej. Tandil y Las Flores)
# CHESS_DEPOSITOS=1                       (opcional: solo estos depósitos)
# CHESS_DIAS_ATRAS=7                      (cuántos días hacia atrás de fecha de pedido se suman)
# CHESS_EXCLUIR_ESTADOS=ANULADO,FACTURADO,RECHAZADO,EMITIDO
# CHESS_CAMPOS={"bultos":["cantBultos"],"cliente":["idCliente"]}
