
# ── ChessERP (API de solo lectura para traer los pedidos pendientes) ──
# Cargá los valores reales en backend/.env (nunca en el código ni en el chat).
# Rutas y campos se confirman con el manual de la API de Chess.
CHESS_BASE_URL=https://beertan.chesserp.com/AR485/web/api/chess/v1
CHESS_USER=
CHESS_PASSWORD=
# CHESS_LOGIN_PATH=auth/login
# CHESS_PEDIDOS_PATH=pedidos
# CHESS_PEDIDOS_QUERY=idSucursal=1        (filtros extra: zona/sucursal de Tandil y Las Flores)
# CHESS_DIAS_ATRAS=15                     (cuántos días hacia atrás buscar pedidos pendientes)
# CHESS_EXCLUIR_ESTADOS=ANULADO,FACTURADO,RECHAZADO
# CHESS_CAMPOS={"bultos":["cantBultos"],"cliente":["idCliente"]}
